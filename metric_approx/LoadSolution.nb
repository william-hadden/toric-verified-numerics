Cell[CellGroupData[{

Cell["Example :  x derivative of MA equation at a point", "Subsection",
 CellChangeTimes->{{3.9864645830280027`*^9, 3.9864646115738163`*^9}, {
  3.986464729585454*^9, 3.986464737034947*^9}, {3.986467666626643*^9, 
  3.986467673900334*^9}},ExpressionUUID->"0b4e4973-b6eb-47e0-927b-\
5220fb871664"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"c1afn", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "x"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "x"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "x", "-", "y"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "x", "-", "y"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["y", "2"]}], ")"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c1bfn", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "x"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "x"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "-", "y"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", "y"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "x", "-", "y"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "x", "-", "y"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c2xxfn", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["x", "2"]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "2"}], "+", 
      SuperscriptBox["x", "2"], "-", 
      RowBox[{"2", " ", "x", " ", "y"}], "+", 
      RowBox[{"2", " ", 
       SuperscriptBox["y", "2"]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c2yyfn", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["y", "2"]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "2"}], "+", 
      RowBox[{"2", " ", 
       SuperscriptBox["x", "2"]}], "-", 
      RowBox[{"2", " ", "x", " ", "y"}], "+", 
      SuperscriptBox["y", "2"]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c2xyfn", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", "2"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["x", "2"]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["y", "2"]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c3fn", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{"3", "-", 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "2"], "-", 
       RowBox[{"x", " ", "y"}], "+", 
       SuperscriptBox["y", "2"]}], ")"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.981522970943392*^9, 3.98152301260282*^9}, {
   3.9815231077414494`*^9, 3.981523133805915*^9}, {3.9815231641270723`*^9, 
   3.981523187128953*^9}, {3.981523249239929*^9, 3.981523251079949*^9}, 
   3.981523406263226*^9, {3.9815258768088827`*^9, 3.9815258780738697`*^9}, {
   3.9816134431847553`*^9, 3.9816134432177153`*^9}, {3.9816134783370237`*^9, 
   3.981613549226058*^9}, {3.9816175717326813`*^9, 3.981617586792921*^9}, {
   3.981631767905294*^9, 3.981631810670684*^9}, {3.981631915540419*^9, 
   3.9816319182526093`*^9}, {3.981634105691183*^9, 3.981634110199106*^9}, {
   3.9822097315027027`*^9, 3.982209753761826*^9}, 3.986464977035963*^9},
 CellLabel->"In[67]:=",ExpressionUUID->"874f2bc5-9724-456b-9292-c435353bfb5d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Ffn", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"hfn", "[", 
      RowBox[{"x", ",", "y"}], "]"}]}], "-", 
    RowBox[{"2", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", " ", 
        RowBox[{
         SuperscriptBox["hfn", 
          TagBox[
           RowBox[{"(", 
            RowBox[{"1", ",", "0"}], ")"}],
           Derivative],
          MultilineFunction->None], "[", 
         RowBox[{"x", ",", "y"}], "]"}]}], "+", 
       RowBox[{"y", " ", 
        RowBox[{
         SuperscriptBox["hfn", 
          TagBox[
           RowBox[{"(", 
            RowBox[{"0", ",", "1"}], ")"}],
           Derivative],
          MultilineFunction->None], "[", 
         RowBox[{"x", ",", "y"}], "]"}]}]}], ")"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9824782147502832`*^9, 3.982478220504304*^9}},
 CellLabel->"In[73]:=",ExpressionUUID->"da7b7951-1db5-433f-8e27-a0ba7019e8ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Gfn", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"c3fn", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "+", 
    RowBox[{
     RowBox[{"c1afn", "[", 
      RowBox[{"x", ",", "y"}], "]"}], " ", 
     RowBox[{
      SuperscriptBox["hfn", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"2", ",", "0"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"x", ",", "y"}], "]"}], 
     RowBox[{
      SuperscriptBox["hfn", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"0", ",", "2"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"x", ",", "y"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"c1bfn", "[", 
      RowBox[{"x", ",", "y"}], "]"}], " ", 
     RowBox[{
      RowBox[{
       SuperscriptBox["hfn", 
        TagBox[
         RowBox[{"(", 
          RowBox[{"1", ",", "1"}], ")"}],
         Derivative],
        MultilineFunction->None], "[", 
       RowBox[{"x", ",", "y"}], "]"}], "^", "2"}]}], "+", 
    RowBox[{
     RowBox[{"c2xxfn", "[", 
      RowBox[{"x", ",", "y"}], "]"}], " ", 
     RowBox[{
      SuperscriptBox["hfn", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"2", ",", "0"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"x", ",", "y"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"c2yyfn", "[", 
      RowBox[{"x", ",", "y"}], "]"}], " ", 
     RowBox[{
      SuperscriptBox["hfn", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"0", ",", "2"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"x", ",", "y"}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"c2xyfn", "[", 
      RowBox[{"x", ",", "y"}], "]"}], " ", 
     RowBox[{
      SuperscriptBox["hfn", 
       TagBox[
        RowBox[{"(", 
         RowBox[{"1", ",", "1"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"x", ",", "y"}], "]"}]}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9824749378841953`*^9, 3.98247494204748*^9}, {
   3.982475096056765*^9, 3.982475116294334*^9}, {3.982475153213743*^9, 
