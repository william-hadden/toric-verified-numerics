Cell[CellGroupData[{

Cell["Chebychev Differentiation Matrices", "Subsubsection",
 CellChangeTimes->{{3.981546736813113*^9, 3.9815467455974693`*^9}, {
  3.986366380069922*^9, 
  3.986366391851935*^9}},ExpressionUUID->"fad8d6de-4f56-4e5c-87b5-\
139072ba14e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"chebGrid", "[", "N_", "]"}], ":=", 
  RowBox[{"Cos", "[", 
   RowBox[{"Pi", " ", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", "N"}], "]"}], "/", "N"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.981546272666436*^9, 3.981546272669632*^9}, {
  3.981546462685375*^9, 3.98154646756275*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"c22290ee-17d6-4908-9eb4-69db8cb67ea0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"chebD", "[", "N_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "c", ",", "D"}], "}"}], ",", 
     RowBox[{
      RowBox[{"x", "=", 
       RowBox[{"Cos", "[", 
        RowBox[{"Pi", " ", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", "N"}], "]"}], "/", "N"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"c", "=", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", "2", "}"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{"1", ",", 
            RowBox[{"{", 
             RowBox[{"N", "-", "1"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", "N"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"D", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "!=", "j"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"c", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}], "/", 
              RowBox[{"c", "[", 
               RowBox[{"[", 
                RowBox[{"j", "+", "1"}], "]"}], "]"}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
              RowBox[{"x", "[", 
               RowBox[{"[", 
                RowBox[{"j", "+", "1"}], "]"}], "]"}]}], ")"}]}], ",", "0"}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "N"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", "N"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"D", "-", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Total", "[", 
         RowBox[{"D", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.981546278787046*^9, 3.981546284161038*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"65657067-5c16-45cf-ae41-2198f6a89672"],

