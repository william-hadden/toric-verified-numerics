Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"NumToCheb", "[", "numlist_List", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tmpvals", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Rationalize", "[", 
         RowBox[{
          RowBox[{"numlist", "[", 
           RowBox[{"[", "ii", "]"}], "]"}], ",", "0"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"ii", ",", "1", ",", "NN"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tmpcoeffs", "=", 
      RowBox[{"FourierDCT", "[", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{"tmpvals", ",", "1000"}], "]"}], ",", "1"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tmpcoeffs", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "/=", "2"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tmpcoeffs", "[", 
       RowBox[{"[", "NN", "]"}], "]"}], "/=", "2"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"tmpcoeffs", "*=", 
      RowBox[{"Sqrt", "[", 
       FractionBox["2", 
        RowBox[{"NN", "-", "1"}]], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "tmpcoeffs", "]"}], ";"}], "\[IndentingNewLine]", 
    ")"}]}], ";"}]], "Input",
