Cell[CellGroupData[{

Cell["Check -- calculate Cheb coeffs on PDeg grid", "Subsubsection",
 CellChangeTimes->{{3.981546736813113*^9, 3.9815467455974693`*^9}, {
  3.986289806339099*^9, 3.986289818740539*^9}, {3.986289961916031*^9, 
  3.986289966770509*^9}, {3.986294387666006*^9, 
  3.986294400065432*^9}},ExpressionUUID->"9760757f-9d1f-4132-b7da-\
22d091331939"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MyNorm", "[", "inarr_List", "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tmp", "=", 
     RowBox[{"Flatten", "[", "inarr", "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"tmpval", "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"tmp", "[", 
         RowBox[{"[", "ii", "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"ii", ",", "1", ",", 
         RowBox[{"Length", "[", "tmp", "]"}]}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Return", "[", "tmpval", "]"}], ";"}], "\[IndentingNewLine]", 
   ")"}]}]], "Input",
 CellChangeTimes->{{3.9864590597138853`*^9, 3.986459126046257*^9}, {
  3.986459164487898*^9, 3.986459164822294*^9}},
 CellLabel->
  "In[222]:=",ExpressionUUID->"2302eda0-9d87-4dac-a3e5-6be2d0d53acf"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"RealSpaceToCheb", "[", "inarr_List", "]"}], ":=", 
   RowBox[{"(", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"tmp", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"FourierDCT", "[", 
          RowBox[{"#", ",", "1"}], "]"}], "&"}], ",", 
        RowBox[{"Reverse", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"inarr", ",", "1000"}], "]"}], ",", "1"}], "]"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"outPDeg", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"FourierDCT", "[", 
          RowBox[{"#", ",", "1"}], "]"}], "&"}], ",", 
        RowBox[{"Transpose", "[", "tmp", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"outPDeg", "=", 
      RowBox[{"2", 
       RowBox[{
        RowBox[{"Transpose", "[", "outPDeg", "]"}], "/", 
        RowBox[{"(", 
         RowBox[{"PDeg", "-", "1"}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"outPDeg", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "All"}], "]"}], "]"}], "/=", "2"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"outPDeg", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "/=", "2"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"outPDeg", "[", 
       RowBox[{"[", 
        RowBox[{"PDeg", ",", "All"}], "]"}], "]"}], "/=", "2"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"outPDeg", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "PDeg"}], "]"}], "]"}], "/=", "2"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "outPDeg", "]"}], ";"}], "\[IndentingNewLine]", 
    ")"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9864561423051977`*^9, 3.9864561819969788`*^9}, {
  3.986458218562682*^9, 3.986458219028327*^9}},
 CellLabel->
  "In[156]:=",ExpressionUUID->"0efe117c-b0b8-44dc-a5e4-0ec325ed28d9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"coeffsPDeg", "=", 
   RowBox[{"RealSpaceToCheb", "[", "harrPDeg", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.986456302606594*^9, 3.986456309756235*^9}, {
  3.986458368562286*^9, 3.9864583687259703`*^9}},
 CellLabel->
  "In[168]:=",ExpressionUUID->"ff20eb4c-0fcc-4c66-a377-0bab851a1ac3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Quick", " ", 
    RowBox[{"check", ":"}]}], " ", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"chebPolyPDeg", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"coeffsPDeg", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"m", "+", "1"}], ",", 
           RowBox[{"n", "+", "1"}]}], "]"}], "]"}], " ", 
        RowBox[{"ChebyshevT", "[", 
         RowBox[{"m", ",", 
          RowBox[{
           RowBox[{"2", "x"}], "-", "1"}]}], "]"}], " ", 
        RowBox[{"ChebyshevT", "[", 
         RowBox[{"n", ",", 
          RowBox[{"1", "-", 
           RowBox[{"2", "y"}]}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"m", ",", "0", ",", 
         RowBox[{"PDeg", "-", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", 
         RowBox[{"PDeg", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"harrPDeg", "[", 
     RowBox[{"[", 
      RowBox[{"50", ",", "160"}], "]"}], "]"}], "-", 
    RowBox[{"chebPolyPDeg", "[", 
     RowBox[{
      RowBox[{"xarrPDeg", "[", 
       RowBox[{"[", "50", "]"}], "]"}], ",", 
      RowBox[{"yarrPDeg", "[", 
       RowBox[{"[", "160", "]"}], "]"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.982146377700328*^9, 3.982146377703911*^9}, {
   3.982146847608592*^9, 3.982146857807803*^9}, {3.9821501966209803`*^9, 
   3.9821502437697973`*^9}, {3.982150426454767*^9, 3.982150458146806*^9}, {
   3.982150492037138*^9, 3.982150523136888*^9}, {3.982150782537622*^9, 
   3.982150785832127*^9}, {3.982154119444148*^9, 3.982154121075178*^9}, 
   3.982208438781365*^9, {3.9822095088412867`*^9, 3.9822095229734497`*^9}, {
   3.982209574701457*^9, 3.9822095809922123`*^9}, {3.982209623504335*^9, 
   3.982209625292631*^9}, {3.986294456374689*^9, 3.986294466242302*^9}, {
   3.9864583940975122`*^9, 3.986458405089694*^9}},
 CellLabel->
  "In[169]:=",ExpressionUUID->"bd54ed5e-0e2f-4030-b463-34db2508a183"],

Cell[BoxData["0``950.3107741979666"], "Output",
 CellChangeTimes->{3.986458420687645*^9},
 CellLabel->
  "Out[170]=",ExpressionUUID->"b42e4a73-5266-48b6-9387-af9264ffa3ff"]
}, Open  ]],

