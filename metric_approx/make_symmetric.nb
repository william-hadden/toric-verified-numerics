Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pos", "=", 
      RowBox[{"posArrList", "[", 
       RowBox[{"[", "ii", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"tmpval", "=", 
      RowBox[{"varsvalcorrected", "[", 
       RowBox[{"[", 
        RowBox[{"indexlist", "[", 
         RowBox[{"[", "ii", "]"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"coeffsSymCorrected", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"pos", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"pos", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "=", "tmpval"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"coeffsSymCorrected", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"pos", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"pos", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"pos", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "+", 
          RowBox[{"pos", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], "tmpval"}]}], ";"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"ii", ",", "1", ",", 
      RowBox[{"Length", "[", "posArrList", "]"}]}], "}"}]}], "]"}], 
  ";"}]], "Input",
