Cell[BoxData[
 RowBox[{
  RowBox[{"coeffsSym", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"ii", "<=", "jj"}], ",", 
       RowBox[{"coeffsExact", "[", 
        RowBox[{"[", 
         RowBox[{"ii", ",", "jj"}], "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"ii", "+", "jj"}], ")"}]}], 
        RowBox[{"coeffsExact", "[", 
         RowBox[{"[", 
          RowBox[{"jj", ",", "ii"}], "]"}], "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", "1", ",", "NN"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"jj", ",", "1", ",", "NN"}], "}"}]}], "]"}]}], ";"}]], "Input",
