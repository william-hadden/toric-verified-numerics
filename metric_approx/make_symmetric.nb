         RowBox[{"2", "y"}]}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "0", ",", 
       RowBox[{"NN", "-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
