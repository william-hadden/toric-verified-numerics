Cell[CellGroupData[{

Cell["Compute MA derivatives", "Subsubsection",
 CellChangeTimes->{{3.981546736813113*^9, 3.9815467455974693`*^9}, {
  3.986289806339099*^9, 3.986289818740539*^9}, {3.986289961916031*^9, 
  3.986289966770509*^9}, {3.986294387666006*^9, 3.986294400065432*^9}, {
  3.9862956363971767`*^9, 3.986295642689756*^9}, {3.986460170626768*^9, 
  3.986460175175211*^9}},ExpressionUUID->"e5a56521-7530-4bba-8a84-\
b1e67cb32630"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "c1afn", ",", "c1bfn", ",", "c2xxfn", ",", "c2yyfn", ",", "c2xyfn", ",", 
    "c3fn"}], "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c1afn", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "x"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "x"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "x", "-", "y"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "+", "x", "-", "y"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["y", "2"]}], ")"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c1bfn", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "x"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "x"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "-", "y"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", "y"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "x", "-", "y"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "+", "x", "-", "y"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"c2xxfn", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      SuperscriptBox["x", "2"]}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "2"}], "+", 
      SuperscriptBox["x", "2"], "-", 
      RowBox[{"2", " ", "x", " ", "y"}], "+", 
