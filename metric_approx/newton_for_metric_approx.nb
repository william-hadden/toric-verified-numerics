Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"chebD", "[", "N_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "c", ",", "D"}], "}"}], ",", 
     RowBox[{
      RowBox[{"x", "=", 
       RowBox[{"Cos", "[", 
        RowBox[{"Pi", " ", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", "N"}], "]"}], "/", "N"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"c", "=", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", "2", "}"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{"1", ",", 
            RowBox[{"{", 
             RowBox[{"N", "-", "1"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], "*", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"-", "1"}], ")"}], "^", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", "N"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"D", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "!=", "j"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"c", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}], "/", 
              RowBox[{"c", "[", 
               RowBox[{"[", 
                RowBox[{"j", "+", "1"}], "]"}], "]"}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"x", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
              RowBox[{"x", "[", 
               RowBox[{"[", 
                RowBox[{"j", "+", "1"}], "]"}], "]"}]}], ")"}]}], ",", "0"}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "N"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", "N"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"D", "-", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Total", "[", 
         RowBox[{"D", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.981546278787046*^9, 3.981546284161038*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"24aba269-ad9c-4696-9dd0-0bd081922b4d"],

