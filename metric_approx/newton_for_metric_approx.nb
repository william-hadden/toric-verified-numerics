Cell[BoxData[
 RowBox[{
  RowBox[{"chebGrid", "[", "N_", "]"}], ":=", 
  RowBox[{"Cos", "[", 
   RowBox[{"Pi", " ", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", "N"}], "]"}], "/", "N"}]}], "]"}]}]], "Input",
