Cell[TextData[{
 "Bound leading exponential\n\n\tLet F = 2 h - 2 (x hx + y hy)\n\t\n\tThen MA \
equation is:    MA = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["e", "F"], "G"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1bd6c7e0-c9a3-4052-98eb-758b13ce8fce"],
 " = const      with G = c1a hxx hyy + ....\n\n\tHere we bound -->  0.410 < \
",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", "F"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dd70d670-bfa2-42ee-b641-e9c99d972525"],
