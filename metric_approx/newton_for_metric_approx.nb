Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"chebPoly", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"coeffs", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"m", "+", "1"}], ",", 
         RowBox[{"n", "+", "1"}]}], "]"}], "]"}], " ", 
      RowBox[{"ChebyshevT", "[", 
       RowBox[{"m", ",", 
        RowBox[{
         RowBox[{"2", "x"}], "-", "1"}]}], "]"}], " ", 
      RowBox[{"ChebyshevT", "[", 
       RowBox[{"n", ",", 
        RowBox[{"1", "-", 
         RowBox[{"2", "y"}]}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "0", ",", 
       RowBox[{"NN", "-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", 
       RowBox[{"NN", "-", "1"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
