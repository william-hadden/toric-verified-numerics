Cell[BoxData[
 RowBox[{"calceq", ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hx", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Dx", ".", 
         RowBox[{"harr", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "jj"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"jj", ",", "1", ",", "NN"}], "}"}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"hxx", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"D2x", ".", 
         RowBox[{"harr", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "jj"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"jj", ",", "1", ",", "NN"}], "}"}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"hy", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Dy", ".", 
        RowBox[{"harr", "[", 
         RowBox[{"[", 
          RowBox[{"ii", ",", "All"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"ii", ",", "1", ",", "NN"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"hyy", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"D2y", ".", 
        RowBox[{"harr", "[", 
         RowBox[{"[", 
          RowBox[{"ii", ",", "All"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"ii", ",", "1", ",", "NN"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"hxy1", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Dy", ".", 
        RowBox[{"hx", "[", 
         RowBox[{"[", 
          RowBox[{"ii", ",", "All"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"ii", ",", "1", ",", "NN"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"hxy2", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Dx", ".", 
         RowBox[{"hy", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "jj"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"jj", ",", "1", ",", "NN"}], "}"}]}], "]"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"hxy", "=", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{"hxy1", "+", "hxy2"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"val", "=", 
     RowBox[{
      RowBox[{"c1a", "*", "hxx", "*", "hyy"}], "+", 
      RowBox[{"c1b", "*", 
       RowBox[{"hxy", "^", "2"}]}], "+", 
      RowBox[{"c2xx", "*", "hxx"}], "+", 
      RowBox[{"c2yy", "*", "hyy"}], "+", 
      RowBox[{"c2xy", "*", "hxy"}], "+", "c3"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"expr", "=", 
     RowBox[{
      RowBox[{"2", "harr"}], "-", 
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"xgrid", "*", "hx"}], "+", 
         RowBox[{"ygrid", "*", "hy"}]}], ")"}]}], "+", 
      RowBox[{"Log", "[", "val", "]"}]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"bcx", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "*", "hx"}], "-", "hy"}], ")"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", 
        RowBox[{"1", ";;", 
         RowBox[{"-", "2"}]}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"bcy", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "*", "hy"}], "-", "hx"}], ")"}], "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"2", ";;", 
         RowBox[{"-", "1"}]}], ",", 
        RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"bccorner", "=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"hx", "-", "hy"}], ")"}], "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"expr", "=", 
     RowBox[{"expr", "-", 
      RowBox[{"expr", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", 
         RowBox[{"-", "2"}]}], "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"expr", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", 
        RowBox[{"-", "2"}]}], "]"}], "]"}], "=", 
     RowBox[{
      RowBox[{"harr", "[", 
       RowBox[{"[", 
        RowBox[{"2", ",", 
         RowBox[{"-", "2"}]}], "]"}], "]"}], "-", "h0val"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"expr", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", 
        RowBox[{"1", ";;", 
         RowBox[{"-", "2"}]}]}], "]"}], "]"}], "=", "bcx"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"expr", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"2", ";;", 
         RowBox[{"-", "1"}]}], ",", 
        RowBox[{"-", "1"}]}], "]"}], "]"}], "=", "bcy"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"expr", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}]}], "]"}], "]"}], "=", "bccorner"}], ";"}], 
   "\[IndentingNewLine]", ")"}]}]], "Input",
