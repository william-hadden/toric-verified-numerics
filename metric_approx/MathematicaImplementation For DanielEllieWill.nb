 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"polyCheb", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "->", 
          RowBox[{"xarr", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ",", 
         RowBox[{"y", "->", 
          RowBox[{"yarr", "[", 
