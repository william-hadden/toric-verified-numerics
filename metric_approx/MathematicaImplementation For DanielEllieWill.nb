Cell[CellGroupData[{

Cell["Recover solution", "Subsubsection",
 CellChangeTimes->{{3.9821026967900124`*^9, 3.9821026983088264`*^9}, {
  3.9839203511653767`*^9, 
  3.9839203530905495`*^9}},ExpressionUUID->"5af39c30-e833-5e46-8139-\
9b8ed30cbc0d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Nspec", "=", "NN"}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Chebyshev", " ", "coordinates", " ", 
    RowBox[{"on", "[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "1"}], "]"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xi", "=", 
   RowBox[{
    RowBox[{"2", " ", "xarr"}], "-", "1"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"eta", "=", 
    RowBox[{
     RowBox[{"2", " ", "yarr"}], "+", "1"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Chebyshev", " ", "evaluation", " ", "matrices"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Tx", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"ChebyshevT", "[", 
       RowBox[{"m", ",", 
        RowBox[{"xi", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "Nspec"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", "0", ",", 
        RowBox[{"Nspec", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Ty", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"ChebyshevT", "[", 
       RowBox[{"n", ",", 
        RowBox[{"eta", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "Nspec"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", 
        RowBox[{"Nspec", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Solve", " ", "H"}], "=", 
    RowBox[{"Tx", ".", "A", ".", 
     RowBox[{"Transpose", "[", "Ty", "]"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmp", "=", 
   RowBox[{"LinearSolve", "[", 
    RowBox[{"Tx", ",", "harr"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Acoeff", "=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"LinearSolve", "[", 
      RowBox[{"Ty", ",", 
       RowBox[{"Transpose", "[", "tmp", "]"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"polyCheb", "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Acoeff", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"m", "+", "1"}], ",", 
         RowBox[{"n", "+", "1"}]}], "]"}], "]"}], " ", 
      RowBox[{"ChebyshevT", "[", 
       RowBox[{"m", ",", 
        RowBox[{
         RowBox[{"2", " ", "x"}], "-", "1"}]}], "]"}], " ", 
      RowBox[{"ChebyshevT", "[", 
       RowBox[{"n", ",", 
        RowBox[{
         RowBox[{"2", " ", "y"}], "+", "1"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "0", ",", 
       RowBox[{"Nspec", "-", "1"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", 
       RowBox[{"Nspec", "-", "1"}]}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9821027391895237`*^9, 
  3.9821027391895237`*^9}},ExpressionUUID->"7bddfb3b-1e1e-f54c-ad3c-\
8a6844520fd8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"errGrid", " ", "=", " ", 
    RowBox[{"Max", "@", 
     RowBox[{"Table", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"polyCheb", " ", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"x", " ", "->", " ", 
              RowBox[{"xarr", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
             RowBox[{"y", " ", "->", " ", 
              RowBox[{"yarr", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}]}], "}"}]}], ")"}], " ", "-", 
         " ", 
         RowBox[{"harr", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", " ", "j"}], "]"}], "]"}]}], "]"}], ",", "\n", 
       "   ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "1", ",", " ", "Nspec"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "1", ",", " ", "Nspec"}], "}"}]}], "\n", 
      "]"}]}]}], ";"}], "\n"}], "\n", "errGrid"}], "Input",
 CellChangeTimes->{{3.9821027488673096`*^9, 
  3.9821027488673096`*^9}},ExpressionUUID->"ccacb13a-9757-684e-8cd3-\
61f75b01d30e"],

