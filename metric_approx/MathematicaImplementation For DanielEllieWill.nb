Cell[CellGroupData[{

Cell["Calculate error in Monge-Ampere equation", "Subsubsection",
 CellChangeTimes->{{3.981546736813113*^9, 3.9815467455974693`*^9}, {
  3.981546791467101*^9, 3.9815467937083883`*^9}, {3.981547183185161*^9, 
  3.981547185773623*^9}, {3.981612863521948*^9, 3.981612886754475*^9}, {
  3.981613212510092*^9, 3.981613225093443*^9}, {3.981613726602434*^9, 
  3.981613728400666*^9}, {3.9816161484878607`*^9, 3.981616150092387*^9}, {
  3.981721272787986*^9, 
  3.9817212989319687`*^9}},ExpressionUUID->"c087a615-799f-4ae4-9204-\
444424b7b056"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"This", " ", "is", " ", "the", " ", "Monge"}], "-", 
    RowBox[{"Ampere", " ", "equation"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"x", ",", "y"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"valfn", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"c1afn", "[", 
        RowBox[{"x", ",", "y"}], "]"}], " ", 
       RowBox[{
        SuperscriptBox["hfn", 
         TagBox[
          RowBox[{"(", 
           RowBox[{"2", ",", "0"}], ")"}],
          Derivative],
         MultilineFunction->None], "[", 
        RowBox[{"x", ",", "y"}], "]"}], 
       RowBox[{
        SuperscriptBox["hfn", 
         TagBox[
          RowBox[{"(", 
           RowBox[{"0", ",", "2"}], ")"}],
          Derivative],
         MultilineFunction->None], "[", 
        RowBox[{"x", ",", "y"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"c1bfn", "[", 
        RowBox[{"x", ",", "y"}], "]"}], " ", 
       RowBox[{
        RowBox[{
         SuperscriptBox["hfn", 
          TagBox[
           RowBox[{"(", 
            RowBox[{"1", ",", "1"}], ")"}],
           Derivative],
          MultilineFunction->None], "[", 
         RowBox[{"x", ",", "y"}], "]"}], "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"c2xxfn", "[", 
        RowBox[{"x", ",", "y"}], "]"}], " ", 
       RowBox[{
        SuperscriptBox["hfn", 
         TagBox[
          RowBox[{"(", 
           RowBox[{"2", ",", "0"}], ")"}],
          Derivative],
         MultilineFunction->None], "[", 
        RowBox[{"x", ",", "y"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"c2yyfn", "[", 
        RowBox[{"x", ",", "y"}], "]"}], " ", 
       RowBox[{
        SuperscriptBox["hfn", 
         TagBox[
          RowBox[{"(", 
           RowBox[{"0", ",", "2"}], ")"}],
          Derivative],
         MultilineFunction->None], "[", 
        RowBox[{"x", ",", "y"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"c2xyfn", "[", 
        RowBox[{"x", ",", "y"}], "]"}], " ", 
       RowBox[{
        SuperscriptBox["hfn", 
         TagBox[
          RowBox[{"(", 
           RowBox[{"1", ",", "1"}], ")"}],
          Derivative],
         MultilineFunction->None], "[", 
        RowBox[{"x", ",", "y"}], "]"}]}], "+", 
      RowBox[{"c3fn", "[", 
       RowBox[{"x", ",", "y"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"MAfn", "=", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"hfn", "[", 
        RowBox[{"x", ",", "y"}], "]"}]}], "-", 
      RowBox[{"2", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", " ", 
          RowBox[{
           SuperscriptBox["hfn", 
            TagBox[
             RowBox[{"(", 
              RowBox[{"1", ",", "0"}], ")"}],
             Derivative],
            MultilineFunction->None], "[", 
           RowBox[{"x", ",", "y"}], "]"}]}], "+", 
         RowBox[{"y", " ", 
          RowBox[{
           SuperscriptBox["hfn", 
            TagBox[
             RowBox[{"(", 
              RowBox[{"0", ",", "1"}], ")"}],
             Derivative],
            MultilineFunction->None], "[", 
           RowBox[{"x", ",", "y"}], "]"}]}]}], ")"}]}], "+", 
      RowBox[{"Log", "[", 
       RowBox[{"valfn", "[", 
        RowBox[{"x", ",", "y"}], "]"}], "]"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9816318315981216`*^9, 3.981631894576819*^9}, {
  3.981632363252864*^9, 3.981632371388586*^9}, {3.981633615434806*^9, 
  3.98163361555896*^9}, {3.981634209585904*^9, 3.98163421185384*^9}, {
  3.981634523617584*^9, 3.981634525529484*^9}, {3.981721303394487*^9, 
  3.9817213175765944`*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"e3a9a39f-d60f-49a1-91bf-32581c768c52"],

Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Compute", " ", "its", " ", "derivatives"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "*)"}]], "Input",
 CellChangeTimes->{{3.9817213201070232`*^9, 3.981721330733181*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"4591fc12-430d-40e9-8129-091252c2ba6e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"MAx", "=", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"MAfn", ",", "x"}], "]"}], "//", "Simplify"}]}], ";"}]], "Input",\

