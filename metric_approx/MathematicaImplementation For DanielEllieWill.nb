Cell[CellGroupData[{

Cell["Differentiate it", "Subsubsection",
 CellChangeTimes->{{3.9821027040570526`*^9, 
  3.9821027088987236`*^9}},ExpressionUUID->"92a661bf-4d0c-8743-acc3-\
450f43615805"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", "ChebDiff1D", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ChebDiff1D", "[", "a_List", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "a", "]"}]}], ",", "b", ",", "k"}], "}"}], ",", 
     RowBox[{
      RowBox[{"b", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0", ",", "n"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"n", "==", "1"}], ",", 
        RowBox[{"Return", "[", "b", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"n", "==", "2"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"b", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "=", 
          RowBox[{"a", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "b", "]"}], ";"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"b", "[", 
        RowBox[{"[", "n", "]"}], "]"}], "=", "0"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"b", "[", 
        RowBox[{"[", 
         RowBox[{"n", "-", "1"}], "]"}], "]"}], "=", "0"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"b", "[", 
        RowBox[{"[", 
         RowBox[{"n", "-", "2"}], "]"}], "]"}], "=", 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"n", "-", "1"}], ")"}], " ", 
        RowBox[{"a", "[", 
         RowBox[{"[", "n", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"k", "=", 
         RowBox[{"n", "-", "3"}]}], ",", 
        RowBox[{"k", ">=", "2"}], ",", 
        RowBox[{"k", "--"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"b", "[", 
           RowBox[{"[", "k", "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"b", "[", 
            RowBox[{"[", 
             RowBox[{"k", "+", "2"}], "]"}], "]"}], "+", 
           RowBox[{"2", " ", "k", " ", 
            RowBox[{"a", "[", 
             RowBox[{"[", 
              RowBox[{"k", "+", "1"}], "]"}], "]"}]}]}]}], ";"}]}], "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"b", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"n", ">=", "3"}], ",", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "+", 
          RowBox[{
           RowBox[{"b", "[", 
            RowBox[{"[", "3", "]"}], "]"}], "/", "2"}]}], ",", 
         RowBox[{"a", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", 
